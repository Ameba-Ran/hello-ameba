# One URL is enough: porin serves llm / asr / tts, and AMEBA_BASE_URL
# back-fills every per-kind URL that is left unset.
AMEBA_BASE_URL=            # e.g. http://<gateway-host>/porin

# Optional per-kind overrides (only if a service lives on another host)
# AMEBA_LLM_BASE_URL=
# AMEBA_ASR_BASE_URL=
# AMEBA_TTS_BASE_URL=

# Dynamic discovery (operator-injected at deploy time; optional for local dev)
# AMEBA_CLOUDBOT_URL=      # e.g. http://<node-ip>:8080
# AMEBA_CLUSTER_ID=        # cluster id; sent as the X-Amebaran-Cluster-ID header

# Identity
AMEBA_API_KEY=
AMEBA_APP_NAME=hello-ameba

# Optional
# AMEBA_LLM_MODEL=      # pick from GET /v1/models on the gateway (type "llm")
# AMEBA_TIMEOUT_S=120
# AMEBA_TLS_VERIFY=true
# AMEBA_ENDPOINT_MODE=auto   # auto | svc | nodeport
